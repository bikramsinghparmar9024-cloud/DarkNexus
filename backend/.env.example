# Copy to backend/.env and fill in. Never commit the real .env.
#
# Generate the two secrets with:
#   python scripts/generate_secrets.py
# The application refuses to start with the placeholder values, so a
# deployment cannot silently run with a signing key published in source.

SECRET_KEY=replace_me_with_a_generated_secret
JWT_SECRET=replace_me_with_a_generated_secret_at_least_32_chars

# True enables verbose errors and relaxes the secret check. Never in production.
DEBUG=False

# ── Tor, for .onion collection ───────────────────────────────────
# Tor Browser listens on 9150/9151; the standalone daemon on 9050/9051.
TOR_ENABLED=False
TOR_SOCKS_PORT=9050
TOR_CONTROL_PORT=9051

# ── Telegram (optional) ──────────────────────────────────────────
# Without these, collection falls back to the public web preview, which
# reaches only the most recent posts of public channels.
# Obtain from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
